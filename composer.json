{
    "name": "tobento/service-notifier",
    "version": "2.0.2",
    "type": "library",
    "description": "Notifier interface for PHP applications.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "notifier",
        "email",
        "sms"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/service-filesystem": "^2.0",
        "tobento/service-autowire": "^2.0",
        "tobento/service-repository": "^2.0",
        "tobento/service-mail": "^2.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/notifier": "^7.3"
    },
    "suggest": {
        "tobento/service-repository-storage": "To support storage channel",
        "tobento/service-migration": "To support storage repository migration"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-container": "^2.0",
        "tobento/service-event": "^2.0",
        "tobento/service-queue": "^2.0",
        "tobento/service-repository-storage": "^2.0",
        "tobento/service-migration": "^2.0",
        "tobento/service-user": "^2.0",
        "symfony/fake-chat-notifier": "^7.3",
        "symfony/vonage-notifier": "^7.3",
        "symfony/slack-notifier": "^7.3",
        "symfony/one-signal-notifier": "^7.3",
        "monolog/monolog": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Notifier\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Notifier\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}